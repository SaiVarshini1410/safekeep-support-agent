{
  "tools": {
    "get_metrics": {
      "metric=memory": {"metric": "memory", "unit": "%", "interval": "4h", "samples": [56, 57, 58, 57, 58, 58], "current": 58},
      "metric=cpu": {"metric": "cpu", "unit": "%", "interval": "4h", "samples": [18, 22, 25, 21, 20, 22], "current": 22},
      "metric=login_rate": {"metric": "login_rate", "unit": "logins/min", "interval": "4h", "samples": [12, 15, 14, 16, 13, 14], "current": 14},
      "metric=auth_sessions": {"metric": "auth_sessions", "unit": "sessions", "interval": "4h", "samples": [290, 305, 310, 300, 312, 310], "current": 310}
    },
    "get_top_processes": {
      "*": {"host": "backup-server-01", "hostMemoryMB": 16384, "processes": [
        {"name": "backup-core (java)", "memoryMB": 5200, "cpuPercent": 12},
        {"name": "catalog-db", "memoryMB": 2100, "cpuPercent": 6},
        {"name": "scheduler", "memoryMB": 350, "cpuPercent": 2},
        {"name": "web-ui", "memoryMB": 180, "cpuPercent": 1}]}
    },
    "get_job_sessions": {
      "*": {"sessionsInMemory": 10, "running": 8, "stale": 0, "oldestStaleAgeHours": 0}
    },
    "get_job_details": {
      "*": {"jobId": "Daily-Gold-VMware", "type": "VM backup", "status": "SUCCESS", "lastRun": "today 01:00 UTC", "vmsTotal": 40, "vmsFailed": 0}
    },
    "get_logs": {
      "*": {"source": "backup-server-01", "lines": [
        "INFO  scheduler: 8 jobs running",
        "INFO  session-cleanup: cycle completed, 2 sessions released",
        "INFO  catalog-sync: catalog synchronized in 41s",
        "INFO  auth: 14 logins in the last minute"]}
    },
    "get_recent_changes": {
      "*": {"changes": [{"when": "21 days ago", "type": "configuration", "detail": "Added datasource vcenter-dr"}]}
    },
    "get_settings": {
      "section=jobs": {"section": "jobs", "maxConcurrentTasks": 8, "snapshotTimeoutMinutes": 30, "retryCount": 1},
      "section=reports": {"section": "reports", "queryTimeoutSeconds": 120, "maxRangeDays": 365},
      "section=storage": {"section": "storage", "defaultTarget": "storage-01", "retentionDaysGold": 30, "retentionDaysSilver": 14},
      "section=auth": {"section": "auth", "sessionTtlMinutes": 30, "tokenReuse": "enabled", "maxSessions": 50000}
    },
    "get_storage_targets": {
      "*": {"targets": [
        {"name": "storage-01", "status": "ONLINE", "usagePercent": 71, "freeTB": 34.8},
        {"name": "storage-02", "status": "ONLINE", "usagePercent": 64, "freeTB": 43.2}]}
    },
    "get_dependency_status": {
      "*": {"dependencies": [
        {"name": "vcenter-prod", "type": "vCenter datasource", "reachable": true, "tls": "OK", "lastSuccessfulCall": "1 min ago"},
        {"name": "vcenter-dr", "type": "vCenter datasource", "reachable": true, "tls": "OK", "lastSuccessfulCall": "2 min ago"},
        {"name": "storage-01", "type": "backup storage server", "reachable": true, "lastHeartbeat": "20 s ago"},
        {"name": "storage-02", "type": "backup storage server", "reachable": true, "lastHeartbeat": "15 s ago"}]}
    },
    "get_affected_operations": {
      "*": {"operations": [
        {"operation": "VMware VM backups (production)", "dependsOn": ["vcenter-prod", "storage-01"]},
        {"operation": "VMware VM restores (production)", "dependsOn": ["vcenter-prod", "storage-01"]},
        {"operation": "VM inventory refresh", "dependsOn": ["vcenter-prod", "vcenter-dr"]},
        {"operation": "DR site VM backups", "dependsOn": ["vcenter-dr", "storage-02"]},
        {"operation": "Kubernetes backups", "dependsOn": ["storage-02"]},
        {"operation": "Scheduled reports", "dependsOn": ["catalog-db"]}]}
    }
  }
}
