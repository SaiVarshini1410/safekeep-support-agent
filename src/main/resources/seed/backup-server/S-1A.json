{
  "tools": {
    "get_metrics": {
      "metric=memory": {"metric": "memory", "unit": "%", "interval": "1 day", "samples": [61, 67, 72, 78, 84, 89, 93], "current": 93, "note": "samples cover the last 7 days"}
    },
    "get_top_processes": {
      "*": {"host": "backup-server-01", "hostMemoryMB": 16384, "processes": [
        {"name": "backup-core (java)", "memoryMB": 11800, "cpuPercent": 14},
        {"name": "catalog-db", "memoryMB": 2150, "cpuPercent": 7},
        {"name": "scheduler", "memoryMB": 360, "cpuPercent": 2},
        {"name": "web-ui", "memoryMB": 190, "cpuPercent": 1}]}
    },
    "get_job_sessions": {
      "*": {"sessionsInMemory": 1180, "running": 8, "stale": 1172, "oldestStaleAgeHours": 142}
    },
    "get_logs": {
      "*": {"source": "backup-server-01", "lines": [
        "INFO  scheduler: 8 jobs running",
        "WARN  session-cleanup: could not acquire lock 'session-registry' within 30s, skipping cycle",
        "WARN  session-cleanup: could not acquire lock 'session-registry' within 30s, skipping cycle",
        "INFO  catalog-sync: holding lock 'session-registry' while synchronizing catalog",
        "WARN  session-cleanup: last successful cycle 6h 04m ago",
        "WARN  backup-core: heap usage 93% after full GC",
        "INFO  auth: 15 logins in the last minute"]}
    },
    "get_recent_changes": {
      "*": {"changes": [
        {"when": "6 days ago", "type": "upgrade", "detail": "Backup Server upgraded from 10.1.3 to 10.1.4"},
        {"when": "21 days ago", "type": "configuration", "detail": "Added datasource vcenter-dr"}]}
    }
  },
  "actions": {
    "purge_stale_sessions": {
      "result": {"status": "OK", "sessionsReleased": 1172},
      "effects": {
        "get_metrics": {"metric=memory": {"metric": "memory", "unit": "%", "interval": "1 day", "samples": [67, 72, 78, 84, 89, 93, 61], "current": 61}},
        "get_job_sessions": {"*": {"sessionsInMemory": 8, "running": 8, "stale": 0, "oldestStaleAgeHours": 0}}
      }
    }
  }
}
